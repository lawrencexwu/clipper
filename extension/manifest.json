{
  "manifest_version": 3,
  "name": "Clipper",
  "version": "0.1.0",
  "description": "Personal web-content capture tool",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Clipper"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "clip-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Clipper on the current tab"
    }
  }
}
